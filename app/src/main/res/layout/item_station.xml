<?xml version="1.0" encoding="utf-8"?>
<!-- Figma ListRow: [배지들 56dp] 역명 / 5호선 · 9호선 ......... [☆ 48dp] -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/row_min_height"
    android:orientation="horizontal">

    <!-- 노선 배지 (코드에서 노선 수만큼 추가) -->
    <LinearLayout
        android:id="@+id/badgeContainer"
        android:layout_width="@dimen/row_badge_area"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:orientation="horizontal" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/stationName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/Text.MyWay.Body16Medium" />

        <TextView
            android:id="@+id/lineNames"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/Text.MyWay.Caption12Medium"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/favoriteButton"
        android:layout_width="@dimen/touch_large"
        android:layout_height="@dimen/touch_large"
        android:layout_marginStart="@dimen/space_m"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_star_outline" />

</LinearLayout>
