<?xml version="1.0" encoding="utf-8"?>
<!-- Figma LineSheetRow: [배지 36] 2호선 / 순환선 · …   [✓ 또는 ›] -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="64dp"
    android:layout_marginTop="10dp"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp">

    <FrameLayout
        android:id="@+id/badge"
        android:layout_width="@dimen/sheet_badge"
        android:layout_height="@dimen/sheet_badge"
        android:background="@drawable/bg_badge_square">

        <TextView
            android:id="@+id/badgeText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textAppearance="@style/Text.MyWay.Body16Bold" />

        <ImageView
            android:id="@+id/badgeIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_map"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Text.MyWay.Body16Bold" />

        <TextView
            android:id="@+id/rowDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/Text.MyWay.Caption12Medium"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <ImageView
        android:id="@+id/rowTrailing"
        android:layout_width="@dimen/icon"
        android:layout_height="@dimen/icon"
        android:importantForAccessibility="no" />
</LinearLayout>
