<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 1-10 행: [배지] 여의도 / 5호선 · 9호선   ☆  ✕ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/row_min_height"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/badgeContainer"
        android:layout_width="@dimen/row_badge_area"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:orientation="horizontal" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/Text.MyWay.Body16Medium" />

        <TextView
            android:id="@+id/sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/Text.MyWay.Caption12Medium"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/favoriteButton"
        android:layout_width="@dimen/touch_large"
        android:layout_height="@dimen/touch_large"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_star_outline" />

    <ImageButton
        android:id="@+id/removeButton"
        android:layout_width="@dimen/touch_large"
        android:layout_height="@dimen/touch_large"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleType="center"
        android:src="@drawable/ic_close_small" />
</LinearLayout>
