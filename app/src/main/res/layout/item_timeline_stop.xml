<?xml version="1.0" encoding="utf-8"?>
<!-- Figma TimelineRow Stop: 05:57 (5) 군자 / 5호선 승차 -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_xl">

    <TextView
        android:id="@+id/time"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:textAppearance="@style/Text.MyWay.Label14Medium"
        android:textColor="@color/text_secondary" />

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp">

        <TextView
            android:id="@+id/badge"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_circle"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textAppearance="@style/Text.MyWay.Caption12Bold" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="@dimen/space_xs">

        <TextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Text.MyWay.Heading18Bold" />

        <TextView
            android:id="@+id/sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/Text.MyWay.Label14Medium"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <!-- 첫 승차역에만: 이동 중 안내 시작 (3-1 열차 선택) -->
    <TextView
        android:id="@+id/pickTrain"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginStart="@dimen/space_s"
        android:background="@drawable/bg_trip_pick"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:text="@string/trip_pick_train"
        android:textAppearance="@style/Text.MyWay.Label14Bold"
        android:visibility="gone" />
</LinearLayout>
