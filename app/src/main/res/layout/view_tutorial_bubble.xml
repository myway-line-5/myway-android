<?xml version="1.0" encoding="utf-8"?>
<!-- Figma TutorialBubble (424:102): 단계 · 제목 · 설명 · 진행 점 · 건너뛰기/시작하기 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tutorial_bubble"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xl"
    android:paddingTop="18dp"
    android:paddingEnd="@dimen/space_xl"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/tutStep"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:textAppearance="@style/Text.MyWay.Caption12Bold"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/tutTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:importantForAccessibility="no"
        android:letterSpacing="-0.02"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tutBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:importantForAccessibility="no"
        android:textAppearance="@style/Text.MyWay.Label14Medium"
        android:textColor="@color/text_secondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="@dimen/space_s">

        <LinearLayout
            android:id="@+id/tutDots"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/tutAction"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_large"
            android:gravity="center"
            android:paddingHorizontal="@dimen/space_xxl"
            android:textAppearance="@style/Text.MyWay.Body16Bold" />
    </LinearLayout>
</LinearLayout>
