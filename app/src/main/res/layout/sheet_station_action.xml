<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 1-12 역 정보 시트 + 역 팝업(출발·도착) -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingBottom="@dimen/space_xxl">

    <!-- 노선 탭 + 즐겨찾기 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_xl"
        android:paddingTop="14dp"
        android:paddingEnd="@dimen/space_s">

        <LinearLayout
            android:id="@+id/lineTabs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <ImageButton
            android:id="@+id/favoriteButton"
            android:layout_width="@dimen/touch_large"
            android:layout_height="@dimen/touch_large"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_star_outline" />
    </LinearLayout>

    <!-- 노선색 띠 + 현재 역 -->
    <FrameLayout
        android:id="@+id/band"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:background="@drawable/bg_band"
        android:paddingHorizontal="@dimen/space_l"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/stationName"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:paddingHorizontal="36dp"
            android:textAppearance="@style/Text.MyWay.Heading18Bold"
            android:textSize="20sp" />
    </FrameLayout>

    <!-- 출발 | 도착 (남색 주 버튼 묶음) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="@dimen/space_xl"
        android:layout_marginTop="@dimen/space_xl"
        android:background="@drawable/bg_action_bar"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/departButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:drawableTop="@drawable/ic_depart"
            android:drawablePadding="2dp"
            android:gravity="center"
            android:paddingTop="10dp"
            android:text="@string/point_origin"
            android:textAppearance="@style/Text.MyWay.Label14Bold"
            android:textColor="@color/text_on_brand" />

        <TextView
            android:id="@+id/arriveButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:drawableTop="@drawable/ic_arrive"
            android:drawablePadding="2dp"
            android:gravity="center"
            android:paddingTop="10dp"
            android:text="@string/point_destination"
            android:textAppearance="@style/Text.MyWay.Label14Bold"
            android:textColor="@color/text_on_brand" />
    </LinearLayout>

    <!-- 5-2 역 상세로 (보조 동작: 주 버튼 아래 한 줄) -->
    <TextView
        android:id="@+id/detailButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_large"
        android:layout_marginHorizontal="@dimen/space_xl"
        android:layout_marginTop="@dimen/space_s"
        android:background="?attr/selectableItemBackground"
        android:drawableEnd="@drawable/ic_chevron_right"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/space_xs"
        android:text="@string/station_detail_open"
        android:textAppearance="@style/Text.MyWay.Label14Bold"
        android:textColor="@color/text_primary" />
</LinearLayout>
