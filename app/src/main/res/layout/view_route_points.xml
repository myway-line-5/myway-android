<?xml version="1.0" encoding="utf-8"?>
<!-- Figma RoutePointsCard (1-13): ⇅ | ● 출발 군자 ✕ / ● 도착 여의도 ✕ -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:elevation="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/space_xs"
    android:paddingStart="@dimen/space_xs"
    android:paddingEnd="@dimen/space_s">

    <ImageButton
        android:id="@+id/swapButton"
        android:layout_width="@dimen/touch_large"
        android:layout_height="@dimen/touch_large"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/route_swap"
        android:src="@drawable/ic_swap_vert" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/originRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:paddingStart="10dp">

            <View
                android:layout_width="@dimen/point_dot"
                android:layout_height="@dimen/point_dot"
                android:background="@drawable/dot_origin" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/point_origin"
                android:textAppearance="@style/Text.MyWay.Caption12Bold"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/originName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/Text.MyWay.Body16Bold" />

            <ImageButton
                android:id="@+id/originClear"
                android:layout_width="@dimen/icon_button"
                android:layout_height="@dimen/icon_button"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_default" />

        <LinearLayout
            android:id="@+id/destinationRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:paddingStart="10dp">

            <View
                android:layout_width="@dimen/point_dot"
                android:layout_height="@dimen/point_dot"
                android:background="@drawable/dot_destination" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/point_destination"
                android:textAppearance="@style/Text.MyWay.Caption12Bold"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/destinationName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/Text.MyWay.Body16Bold" />

            <ImageButton
                android:id="@+id/destinationClear"
                android:layout_width="@dimen/icon_button"
                android:layout_height="@dimen/icon_button"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
