<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 1-18 경로 결과: 탭 / 출발·도착 카드 / 요약 / 시간 / 타임라인 -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_surface"
    android:orientation="vertical">

    <!-- 기준 탭 + 닫기 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_s">

        <!-- 맞춤(선호 반영) 탭이 붙으면 4칸 → 좁은 화면에서는 옆으로 밀어 보기 -->
        <HorizontalScrollView
            android:id="@+id/tabScroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <include android:id="@+id/tabPref" layout="@layout/item_route_tab" android:visibility="gone" />
                <include android:id="@+id/tabTime" layout="@layout/item_route_tab" />
                <include android:id="@+id/tabTransfer" layout="@layout/item_route_tab" />
                <include android:id="@+id/tabFare" layout="@layout/item_route_tab" />
            </LinearLayout>
        </HorizontalScrollView>

        <ImageButton
            android:id="@+id/closeButton"
            android:layout_width="@dimen/touch_large"
            android:layout_height="@dimen/touch_large"
            android:layout_gravity="center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/result_close"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_default" />

    <!-- 2-6: AI 조건 반영 표시 -->
    <TextView
        android:id="@+id/aiBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_l"
        android:layout_marginTop="@dimen/space_m"
        android:background="@drawable/bg_ai_banner"
        android:paddingHorizontal="@dimen/space_m"
        android:paddingVertical="10dp"
        android:textAppearance="@style/Text.MyWay.Label14Bold"
        android:textColor="@color/ai_banner_text"
        android:visibility="gone" />

    <!-- 오프라인: 즐겨찾기에 저장해 둔 경로를 보여 주는 중 -->
    <TextView
        android:id="@+id/savedBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_l"
        android:layout_marginTop="@dimen/space_m"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/bg_pinch_hint"
        android:paddingHorizontal="@dimen/space_m"
        android:paddingVertical="10dp"
        android:textAppearance="@style/Text.MyWay.Label14Bold"
        android:textColor="@color/text_on_brand"
        android:visibility="gone" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/brand_navy"
        app:trackColor="@color/bg_muted"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/routeCard"
                layout="@layout/view_route_points"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_l"
                android:layout_marginTop="@dimen/space_m" />

            <!-- 요약: 소요시간 47분 / 환승 2회 | 1,950원 / ☆ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_xl"
                android:paddingTop="@dimen/space_m"
                android:paddingEnd="@dimen/space_s"
                android:paddingBottom="@dimen/space_m">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/durationLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/result_duration_label"
                        android:textAppearance="@style/Text.MyWay.Caption12Medium"
                        android:textColor="@color/text_secondary" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/totalTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/Text.MyWay.Display40Bold" />

                        <TextView
                            android:id="@+id/transfers"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:paddingBottom="6dp"
                            android:textAppearance="@style/Text.MyWay.Label14Medium"
                            android:textColor="@color/text_secondary" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="12dp"
                            android:layout_marginHorizontal="@dimen/space_s"
                            android:layout_marginBottom="8dp"
                            android:background="@color/border_default" />

                        <TextView
                            android:id="@+id/fare"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingBottom="6dp"
                            android:textAppearance="@style/Text.MyWay.Label14Medium"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 경로 읽어주기 (TTS, 최지윤 PR #18) — 지도·즐겨찾기 옆 아이콘으로 -->
                <ImageButton
                    android:id="@+id/speakButton"
                    android:layout_width="@dimen/touch_large"
                    android:layout_height="@dimen/touch_large"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/result_speak"
                    android:src="@drawable/ic_set_voice"
                    app:tint="@color/icon_default"
                    xmlns:app="http://schemas.android.com/apk/res-auto" />

                <ImageButton
                    android:id="@+id/mapButton"
                    android:layout_width="@dimen/touch_large"
                    android:layout_height="@dimen/touch_large"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/result_map"
                    android:src="@drawable/ic_map"
                    app:tint="@color/icon_default"
                    xmlns:app="http://schemas.android.com/apk/res-auto" />

                <ImageButton
                    android:id="@+id/favoriteButton"
                    android:layout_width="@dimen/touch_large"
                    android:layout_height="@dimen/touch_large"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/result_favorite"
                    android:src="@drawable/ic_star_outline" />
            </LinearLayout>

            <!-- 출발·도착 시각 (지금 출발 기준. 시각 선택은 시간표 탐색 확정 전 비활성) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_l"
                android:paddingTop="@dimen/space_xs"
                android:paddingBottom="@dimen/space_s">

                <LinearLayout
                    android:id="@+id/departChip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_time_chip"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/result_depart"
                        android:textAppearance="@style/Text.MyWay.Caption12Bold"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/departTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s"
                        android:textAppearance="@style/Text.MyWay.Body16Bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/arriveChip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:layout_weight="1"
                    android:background="@drawable/bg_time_chip"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/result_arrive"
                        android:textAppearance="@style/Text.MyWay.Caption12Bold"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/arriveTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s"
                        android:textAppearance="@style/Text.MyWay.Body16Bold" />
                </LinearLayout>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/timeline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingTop="@dimen/space_s"
                android:paddingBottom="@dimen/space_xxl"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                xmlns:app="http://schemas.android.com/apk/res-auto" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 오류: 경로 없음 / 연결 실패 -->
    <LinearLayout
        android:id="@+id/errorView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_xxl"
        android:paddingTop="60dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/errorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="@style/Text.MyWay.Heading18Bold" />

        <TextView
            android:id="@+id/errorBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textAppearance="@style/Text.MyWay.Label14Medium"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/retryButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_xxl"
            android:background="@drawable/bg_button_primary"
            android:gravity="center"
            android:text="@string/result_retry"
            android:textAppearance="@style/Text.MyWay.Body16Bold"
            android:textColor="@color/text_on_brand" />
    </LinearLayout>
</LinearLayout>
