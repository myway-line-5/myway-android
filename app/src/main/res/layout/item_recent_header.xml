<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="40dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:accessibilityHeading="true"
        android:textAppearance="@style/Text.MyWay.Label14Bold"
        android:textColor="@color/text_secondary" />

    <TextView
        android:id="@+id/clearAll"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_large"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:paddingHorizontal="@dimen/space_s"
        android:text="@string/recent_clear_all"
        android:textAppearance="@style/Text.MyWay.Caption12Medium"
        android:textColor="@color/text_secondary" />
</LinearLayout>
