<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 1-1 서비스 범위 안내: 호선 배지 32 / 제목 20 / 본문 14 / 주 버튼 56 + 보조 텍스트 버튼 -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xxl"
    android:paddingTop="24dp"
    android:paddingEnd="@dimen/space_xxl"
    android:paddingBottom="@dimen/space_s">

    <LinearLayout
        android:id="@+id/scopeLines"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/scopeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/scope_title"
        android:textAppearance="@style/Text.MyWay.Heading18Bold"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/scopeBody"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/scope_body"
        android:textAppearance="@style/Text.MyWay.Label14Medium"
        android:textColor="@color/text_secondary" />

    <TextView
        android:id="@+id/scopeOk"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="@dimen/space_xxl"
        android:background="@drawable/bg_button_primary"
        android:gravity="center"
        android:text="@string/scope_ok"
        android:textAppearance="@style/Text.MyWay.Body16Bold"
        android:textColor="@color/text_on_brand"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/scopeNever"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/space_xs"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:text="@string/scope_never"
        android:textAppearance="@style/Text.MyWay.Label14Medium"
        android:textColor="@color/text_secondary" />
</LinearLayout>
