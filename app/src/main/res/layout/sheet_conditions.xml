<?xml version="1.0" encoding="utf-8"?>
<!-- UC-05 경로 조건 설정: 제한(시간·환승·요금) + 선호(먼저 볼 기준). 선택지는 줄마다 4~5개 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_xl"
        android:paddingBottom="@dimen/space_xxl">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="@string/cond_title"
                android:textAppearance="@style/Text.MyWay.Heading18Bold"
                android:textSize="@dimen/text_heading20" />

            <ImageButton
                android:id="@+id/closeButton"
                android:layout_width="@dimen/touch_large"
                android:layout_height="@dimen/touch_large"
                android:layout_marginEnd="-14dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cond_close"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cond_sub"
            android:textAppearance="@style/Text.MyWay.Label14Medium"
            android:textColor="@color/text_secondary" />

        <TextView
            style="@style/ConditionLabel"
            android:text="@string/cond_time" />

        <LinearLayout
            android:id="@+id/timeRow"
            style="@style/ConditionRow" />

        <TextView
            style="@style/ConditionLabel"
            android:text="@string/cond_transfers" />

        <LinearLayout
            android:id="@+id/transferRow"
            style="@style/ConditionRow" />

        <TextView
            style="@style/ConditionLabel"
            android:text="@string/cond_fare" />

        <LinearLayout
            android:id="@+id/fareRow"
            style="@style/ConditionRow" />

        <TextView
            style="@style/ConditionLabel"
            android:text="@string/cond_priority" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/cond_priority_help"
            android:textAppearance="@style/Text.MyWay.Caption12Medium"
            android:textColor="@color/text_secondary" />

        <LinearLayout
            android:id="@+id/prefRow"
            style="@style/ConditionRow" />

        <!-- 초기화(보조) 1 : 적용(주) 2 — 자주 누르는 쪽을 크게 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxl"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/resetButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_weight="1"
                android:background="@drawable/bg_button_secondary"
                android:gravity="center"
                android:text="@string/cond_reset"
                android:textAppearance="@style/Text.MyWay.Body16Bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/applyButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_marginStart="@dimen/space_s"
                android:layout_weight="2"
                android:background="@drawable/bg_button_primary"
                android:gravity="center"
                android:text="@string/cond_apply"
                android:textAppearance="@style/Text.MyWay.Body16Bold"
                android:textColor="@color/text_on_brand" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
