<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 3-2 ~ 3-10 이동 중 안내. 상태별로 가운데 묶음 하나만 보임 -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_surface"
    android:fitsSystemWindows="false"
    android:orientation="vertical">

    <!-- 상단: 경로 요약 · 실시간 칩 · 안내 종료 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_xl"
        android:paddingEnd="@dimen/space_s">

        <TextView
            android:id="@+id/routePill"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/Text.MyWay.Label14Bold" />

        <TextView
            android:id="@+id/feedChip"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="@dimen/space_s"
            android:background="@drawable/bg_trip_chip"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:textAppearance="@style/Text.MyWay.Caption12Bold" />

        <ImageButton
            android:id="@+id/endButton"
            android:layout_width="@dimen/touch_large"
            android:layout_height="@dimen/touch_large"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/trip_end"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- 안내 띠 (3-3 남은 역 / 3-8 지연 / 3-9 오프라인) -->
    <LinearLayout
        android:id="@+id/banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_xl"
        android:layout_marginTop="@dimen/space_xs"
        android:background="@drawable/bg_trip_banner"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_l"
        android:paddingVertical="@dimen/space_m"
        android:visibility="gone">

        <TextView
            android:id="@+id/bannerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Text.MyWay.Label14Bold" />

        <TextView
            android:id="@+id/bannerSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/Text.MyWay.Caption12Medium"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 3-2 · 3-3 · 3-8 · 3-9 타고 가는 중 -->
        <LinearLayout
            android:id="@+id/rideGroup"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_xl">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:text="@string/trip_now"
                android:textAppearance="@style/Text.MyWay.Caption12Bold"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/stationNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/Text.MyWay.Heading18Bold"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/stationNowSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/Text.MyWay.Label14Medium"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/untilLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="@dimen/space_xxl"
                android:text="@string/trip_until"
                android:textAppearance="@style/Text.MyWay.Label14Bold"
                android:textColor="@color/text_secondary" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/remainCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/Text.MyWay.Display40Bold"
                    android:textSize="120sp" />

                <TextView
                    android:id="@+id/stopsUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:layout_marginBottom="22dp"
                    android:text="@string/trip_stops_unit"
                    android:textAppearance="@style/Text.MyWay.Heading18Bold"
                    android:textSize="28sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/eta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:textAppearance="@style/Text.MyWay.Body16Medium"
                android:textColor="@color/text_secondary" />

            <com.myway.app.ui.trip.TripProgressView
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginHorizontal="@dimen/space_xl"
                android:layout_marginTop="@dimen/space_xl"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/boardLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/Text.MyWay.Caption12Medium"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/alightLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/Text.MyWay.Caption12Bold" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_xl"
                android:background="@drawable/bg_card_outline"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="@dimen/space_xl">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/trip_next_action"
                    android:textAppearance="@style/Text.MyWay.Caption12Bold"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/nextTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textAppearance="@style/Text.MyWay.Heading18Bold" />

                <TextView
                    android:id="@+id/nextSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textAppearance="@style/Text.MyWay.Label14Medium"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3-4 지금 내리세요 (남색 전체) -->
        <LinearLayout
            android:id="@+id/alightGroup"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:visibility="gone">

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.8"
                android:text="@string/trip_arrive_label"
                android:textAppearance="@style/Text.MyWay.Label14Bold"
                android:textColor="@color/text_on_brand" />

            <TextView
                android:id="@+id/alightStation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:textAppearance="@style/Text.MyWay.Display40Bold"
                android:textColor="@color/text_on_brand"
                android:textSize="48sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/trip_get_off_now"
                android:textAppearance="@style/Text.MyWay.Heading18Bold"
                android:textColor="@color/text_on_brand"
                android:textSize="28sp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.4" />

            <LinearLayout
                android:id="@+id/alightNextCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_trip_on_dark"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_xl">

                <LinearLayout
                    android:id="@+id/alightNextBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/alightNextTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/Text.MyWay.Body16Bold"
                        android:textColor="@color/text_on_brand" />

                    <TextView
                        android:id="@+id/alightNextSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:alpha="0.8"
                        android:textAppearance="@style/Text.MyWay.Caption12Medium"
                        android:textColor="@color/text_on_brand" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 3-5 환승 안내 -->
        <LinearLayout
            android:id="@+id/transferGroup"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="@dimen/space_xl"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trip_transfer"
                android:textAppearance="@style/Text.MyWay.Caption12Bold"
                android:textColor="@color/text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/transferBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/transferTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/Text.MyWay.Heading18Bold"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/transferSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/Text.MyWay.Label14Medium"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/transferSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- 3-6 · 3-7 경고 -->
        <LinearLayout
            android:id="@+id/warnGroup"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_xl"
            android:paddingTop="@dimen/space_s"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_trip_alert"
                android:orientation="vertical"
                android:padding="@dimen/space_xxl">

                <TextView
                    android:id="@+id/warnLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/Text.MyWay.Label14Bold"
                    android:textColor="@color/text_on_brand" />

                <TextView
                    android:id="@+id/warnTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textAppearance="@style/Text.MyWay.Heading18Bold"
                    android:textColor="@color/text_on_brand"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/warnSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textAppearance="@style/Text.MyWay.Body16Bold"
                    android:textColor="@color/text_on_brand" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxl"
                android:text="@string/trip_reroute"
                android:textAppearance="@style/Text.MyWay.Caption12Bold"
                android:textColor="@color/text_secondary" />

            <LinearLayout
                android:id="@+id/rerouteSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_card_outline"
                android:orientation="vertical"
                android:padding="@dimen/space_xl" />
        </LinearLayout>

        <!-- 3-10 도착 -->
        <LinearLayout
            android:id="@+id/arrivedGroup"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="40dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_check_circle"
                app:tint="@color/brand_navy" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/trip_arrived"
                android:textAppearance="@style/Text.MyWay.Heading18Bold"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/arrivedStation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textAppearance="@style/Text.MyWay.Heading18Bold"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/arrivedSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:textAppearance="@style/Text.MyWay.Label14Medium"
                android:textColor="@color/text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card_outline"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_xl">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/trip_planned"
                        android:textAppearance="@style/Text.MyWay.Caption12Medium"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/plannedTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/Text.MyWay.Heading18Bold"
                        android:textSize="22sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/trip_actual"
                        android:textAppearance="@style/Text.MyWay.Caption12Medium"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/actualTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/Text.MyWay.Heading18Bold"
                        android:textSize="22sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/diffBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_pill"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:textAppearance="@style/Text.MyWay.Caption12Bold"
                    android:textColor="@color/text_on_brand" />
            </LinearLayout>

            <!-- 도착 인사: 시간대별 한마디 (날씨 API 붙으면 greetSub 자리에 날씨) -->
            <LinearLayout
                android:id="@+id/greetCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:background="@drawable/bg_greet_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_xl">

                <ImageView
                    android:id="@+id/greetIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:importantForAccessibility="no"
                    app:tint="@color/brand_navy" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_l"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/greetTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/Text.MyWay.Heading18Bold" />

                    <TextView
                        android:id="@+id/greetSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textAppearance="@style/Text.MyWay.Label14Medium"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- 하단 버튼 두 개 (왼쪽 보조 · 오른쪽 상황에 따라 주 버튼) -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_xl"
        android:paddingTop="@dimen/space_l"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/leftButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:gravity="center"
            android:textAppearance="@style/Text.MyWay.Body16Bold" />

        <TextView
            android:id="@+id/rightButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="@dimen/space_s"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:gravity="center"
            android:textAppearance="@style/Text.MyWay.Body16Bold" />
    </LinearLayout>
</LinearLayout>
