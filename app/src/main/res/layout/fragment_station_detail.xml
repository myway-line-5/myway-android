<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 5-2 역 상세: 헤더(← 역명 ☆) · 노선 탭 · 첫차막차 · 시간표 · 혼잡도 · 편의시설 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_s">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="@dimen/touch_large"
            android:layout_height="@dimen/touch_large"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/detail_back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:ellipsize="end"
            android:letterSpacing="-0.02"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_title"
            android:fontFamily="@font/noto_sans_kr_bold" />

        <ImageButton
            android:id="@+id/favoriteButton"
            android:layout_width="@dimen/touch_large"
            android:layout_height="@dimen/touch_large"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_star_outline" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lineTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_xl" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_l"
            android:paddingTop="@dimen/space_m"
            android:paddingBottom="@dimen/space_xxl">

            <ProgressBar
                android:id="@+id/loading"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="48dp"
                android:indeterminateTint="@color/brand_navy" />

            <TextView
                android:id="@+id/errorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:gravity="center"
                android:text="@string/detail_error"
                android:textAppearance="@style/Text.MyWay.Label14Medium"
                android:textColor="@color/text_secondary"
                android:visibility="gone" />

            <!-- 첫차 · 막차 -->
            <LinearLayout
                android:id="@+id/firstLastCard"
                style="@style/Detail_Card">

                <TextView
                    style="@style/Detail_CardLabel"
                    android:text="@string/detail_first_last" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:gravity="center_vertical"
                    android:importantForAccessibility="noHideDescendants"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/detail_direction"
                        android:textAppearance="@style/Text.MyWay.Caption12Medium"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        style="@style/Detail_TimeHeader"
                        android:text="@string/detail_first" />

                    <TextView
                        style="@style/Detail_TimeHeader"
                        android:text="@string/detail_last" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/firstLastRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- 시간표 -->
            <LinearLayout
                android:id="@+id/timetableCard"
                style="@style/Detail_Card">

                <TextView
                    style="@style/Detail_CardLabel"
                    android:text="@string/detail_timetable" />

                <LinearLayout
                    android:id="@+id/dayTabs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_detail_segment"
                    android:orientation="horizontal"
                    android:padding="4dp" />

                <LinearLayout
                    android:id="@+id/timetableRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- 시간대별 혼잡도 -->
            <LinearLayout
                android:id="@+id/congestionCard"
                style="@style/Detail_Card">

                <TextView
                    style="@style/Detail_CardLabel"
                    android:text="@string/detail_congestion" />

                <LinearLayout
                    android:id="@+id/bars"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginTop="10dp"
                    android:gravity="bottom"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:id="@+id/barLabels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:importantForAccessibility="noHideDescendants"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/nowText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/Text.MyWay.Label14Medium"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/nowLevel"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginStart="@dimen/space_s"
                        android:background="@drawable/bg_detail_level"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:textAppearance="@style/Text.MyWay.Caption12Bold"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
            </LinearLayout>

            <!-- 편의시설 -->
            <LinearLayout
                android:id="@+id/facilityCard"
                style="@style/Detail_Card">

                <TextView
                    style="@style/Detail_CardLabel"
                    android:text="@string/detail_facilities" />

                <LinearLayout
                    android:id="@+id/facilityRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 정보를 본 뒤 바로 출발·도착으로 (역 시트와 같은 남색 묶음, 엄지 영역) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="@dimen/space_l"
        android:layout_marginTop="@dimen/space_s"
        android:layout_marginBottom="@dimen/space_l"
        android:background="@drawable/bg_action_bar"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/departButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:drawableTop="@drawable/ic_depart"
            android:drawablePadding="2dp"
            android:gravity="center"
            android:paddingTop="10dp"
            android:text="@string/point_origin"
            android:textAppearance="@style/Text.MyWay.Label14Bold"
            android:textColor="@color/text_on_brand" />

        <TextView
            android:id="@+id/arriveButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:drawableTop="@drawable/ic_arrive"
            android:drawablePadding="2dp"
            android:gravity="center"
            android:paddingTop="10dp"
            android:text="@string/point_destination"
            android:textAppearance="@style/Text.MyWay.Label14Bold"
            android:textColor="@color/text_on_brand" />
    </LinearLayout>
</LinearLayout>
