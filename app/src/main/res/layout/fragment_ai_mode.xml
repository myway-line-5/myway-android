<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 2-1~2-10 AI 모드. 상태에 따라 아래 블록을 켜고 끈다 -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ai_bg">

    <!-- ? · AI 모드 · ⚙ -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="@dimen/top_bar_height"
        android:layout_marginTop="@dimen/space_s"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_l"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="@dimen/icon_button"
            android:layout_height="@dimen/icon_button"
            android:background="@drawable/bg_ai_icon_box"
            android:contentDescription="@string/ai_back_desc"
            android:src="@drawable/ic_ai_back"
            android:tint="@android:color/white"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/helpButton"
            android:layout_width="@dimen/icon_button"
            android:layout_height="@dimen/icon_button"
            android:background="@drawable/bg_ai_icon_box"
            android:contentDescription="@string/home_help"
            android:src="@drawable/ic_help"
            android:tint="@android:color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:gravity="center"
            android:text="@string/ai_title"
            android:textAppearance="@style/Text.MyWay.Body16Bold"
            android:textColor="@android:color/white" />

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="@dimen/icon_button"
            android:layout_height="@dimen/icon_button"
            android:background="@drawable/bg_ai_icon_box"
            android:contentDescription="@string/home_settings"
            android:src="@drawable/ic_settings"
            android:tint="@android:color/white" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomArea">

        <LinearLayout
            android:id="@+id/column"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_l"
            android:paddingBottom="@dimen/space_l">

            <!-- 제목 (마스코트 위 또는 아래로 코드에서 옮김) -->
            <LinearLayout
                android:id="@+id/titleBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:gravity="center"
                    android:textAppearance="@style/Text.MyWay.Heading18Bold"
                    android:textColor="@android:color/white"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:gravity="center"
                    android:textAppearance="@style/Text.MyWay.Label14Medium"
                    android:textColor="@color/ai_text_secondary" />
            </LinearLayout>

            <!-- 마스코트 '웨이' + 빛 -->
            <FrameLayout
                android:id="@+id/mascotBox"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_marginTop="@dimen/space_s"
                android:importantForAccessibility="noHideDescendants">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_ai_glow" />

                <ImageView
                    android:id="@+id/mascot"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ai_mascot" />
            </FrameLayout>

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/Text.MyWay.Label14Medium"
                android:textColor="@color/ai_text_secondary" />

            <!-- 2-4 내가 한 말 + … -->
            <LinearLayout
                android:id="@+id/busyBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxl"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ai_card"
                    android:orientation="vertical"
                    android:padding="@dimen/space_l">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_you_said"
                        android:textAppearance="@style/Text.MyWay.Caption12Medium"
                        android:textColor="@color/ai_text_secondary" />

                    <TextView
                        android:id="@+id/quote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="@style/Text.MyWay.Body16Bold"
                        android:textColor="@android:color/white" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/dots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxl"
                    android:importantForAccessibility="no"
                    android:orientation="horizontal">

                    <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/bg_ai_dot" />
                    <View android:layout_width="10dp" android:layout_height="10dp" android:layout_marginStart="8dp" android:background="@drawable/bg_ai_dot" />
                    <View android:layout_width="10dp" android:layout_height="10dp" android:layout_marginStart="8dp" android:background="@drawable/bg_ai_dot" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/ai_busy_hint"
                    android:textAppearance="@style/Text.MyWay.Caption12Medium"
                    android:textColor="@color/ai_text_secondary" />
            </LinearLayout>

            <!-- 2-5 해석 확인 카드 -->
            <LinearLayout
                android:id="@+id/confirmCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:background="@drawable/bg_ai_card"
                android:orientation="vertical"
                android:paddingVertical="@dimen/space_s">

                <include android:id="@+id/originRow" layout="@layout/item_ai_point" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="@dimen/space_l"
                    android:background="@color/ai_surface_2" />

                <include android:id="@+id/destinationRow" layout="@layout/item_ai_point" />

                <TextView
                    android:id="@+id/limitsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_l"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/ai_limits"
                    android:textAppearance="@style/Text.MyWay.Caption12Medium"
                    android:textColor="@color/ai_text_secondary" />

                <LinearLayout
                    android:id="@+id/limits"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/space_l"
                    android:layout_marginTop="@dimen/space_s"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/priorityLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_l"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/ai_priority"
                    android:textAppearance="@style/Text.MyWay.Caption12Medium"
                    android:textColor="@color/ai_text_secondary" />

                <LinearLayout
                    android:id="@+id/priorities"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/space_l"
                    android:layout_marginTop="@dimen/space_s"
                    android:layout_marginBottom="@dimen/space_s"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </LinearLayout>

            <TextView
                android:id="@+id/confirmHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/ai_priority_help"
                android:textAppearance="@style/Text.MyWay.Caption12Medium"
                android:textColor="@color/ai_text_secondary" />

            <!-- 2-8 후보 / 2-9 대안 선택지 (코드에서 채움) -->
            <TextView
                android:id="@+id/optionsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/ai_unsupported_ask"
                android:textAppearance="@style/Text.MyWay.Body16Bold"
                android:textColor="@android:color/white" />

            <LinearLayout
                android:id="@+id/options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:orientation="vertical" />

            <!-- 2-10 오류 안내 -->
            <LinearLayout
                android:id="@+id/errorBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:background="@drawable/bg_ai_error"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_l">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_error_small" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:layout_weight="1"
                    android:text="@string/ai_failed_body"
                    android:textAppearance="@style/Text.MyWay.Label14Medium"
                    android:textColor="@color/ai_error_text" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 하단: 입력창(2-1/2-2) 또는 버튼(그 외) -->
    <LinearLayout
        android:id="@+id/bottomArea"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_l"
        android:paddingBottom="@dimen/space_l"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/inputBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/normalButton"
                android:layout_width="@dimen/fab"
                android:layout_height="@dimen/fab"
                android:background="@drawable/bg_ai_mode_back"
                android:contentDescription="@string/ai_normal_desc"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_train" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="@string/ai_normal"
                    android:textAppearance="@style/Text.MyWay.Caption12Bold"
                    android:textColor="@android:color/white" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/inputBox"
                android:layout_width="0dp"
                android:layout_height="@dimen/search_field_height"
                android:layout_marginStart="@dimen/space_s"
                android:layout_weight="1"
                android:background="@drawable/bg_ai_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_l"
                android:paddingEnd="6dp">

                <EditText
                    android:id="@+id/input"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/ai_input_hint"
                    android:imeOptions="actionSend"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLength="1000"
                    android:maxLines="1"
                    android:textAppearance="@style/Text.MyWay.Body16Medium"
                    android:textColorHint="@color/text_secondary" />

                <ImageButton
                    android:id="@+id/sendButton"
                    android:layout_width="@dimen/icon_button"
                    android:layout_height="@dimen/icon_button"
                    android:background="@drawable/bg_ai_send"
                    android:contentDescription="@string/ai_send"
                    android:src="@drawable/ic_send" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/primaryButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/fab"
            android:background="@drawable/bg_ai_primary"
            android:gravity="center"
            android:textAppearance="@style/Text.MyWay.Body16Bold"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/secondaryButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/fab"
            android:layout_marginTop="@dimen/space_s"
            android:background="@drawable/bg_ai_outline"
            android:gravity="center"
            android:textAppearance="@style/Text.MyWay.Body16Bold"
            android:textColor="@android:color/white" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
