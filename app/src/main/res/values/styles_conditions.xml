<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ConditionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_xl</item>
        <item name="android:textAppearance">@style/Text.MyWay.Label14Bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:accessibilityHeading">true</item>
    </style>

    <style name="ConditionRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_s</item>
        <item name="android:orientation">horizontal</item>
    </style>
</resources>
