<?xml version="1.0" encoding="utf-8"?>
<!-- 출발·도착 시간 칩. 시간 설정에서 고른 기준 칩은 남색 1.5dp 테두리 (Figma 1-19) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_canvas" />
            <stroke android:width="1.5dp" android:color="@color/brand_navy" />
            <corners android:radius="@dimen/radius_input" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_canvas" />
            <stroke android:width="1dp" android:color="@color/border_default" />
            <corners android:radius="@dimen/radius_input" />
        </shape>
    </item>
</selector>
