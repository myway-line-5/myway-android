<?xml version="1.0" encoding="utf-8"?>
<!-- 조건 선택지: 고른 것 = 남색 채움(눈에 띄게), 나머지 = 흰 바탕 + 테두리 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_navy" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_surface" />
            <stroke android:width="1dp" android:color="@color/border_strong" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>
</selector>
